  },
  {
   "@type": "FAQPage",
   "@id": "https://get-lumic.com/resources/how-to-implement-ai-in-a-small-business/#faq",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "Where should a small business start with AI?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "With one job: the one that takes the most hours by hand and repeats every day or every month. One job, not a department."
     }
    },
    {
     "@type": "Question",
     "name": "Does AI need upkeep after it goes live?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. Systems change, document layouts change, and AI models improve. Someone has to watch the agent, test it every month, fix what breaks and upgrade it."
     }
    }
   ]
  },
