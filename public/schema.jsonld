  {
   "@type": "FAQPage",
   "@id": "https://get-lumic.com/managed-ai/#faq",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "What is a managed AI agent?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "An AI agent that lumic built for one job and runs for a monthly fee. The team watches it, tests it every month, fixes what breaks, and upgrades it as AI improves. A person on your team approves anything before it posts."
     }
    },
    {
     "@type": "Question",
     "name": "Can an agent be paused?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. Any agent can be paused, or its access revoked, at any time."
     }
    },
    {
     "@type": "Question",
     "name": "What does the retainer cost?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Managed AI from $250 to $5,000 a month, depending on scope. The build is a separate, one-time cost, priced in the written proposal. These figures are starting points, not quotes."
     }
    }
