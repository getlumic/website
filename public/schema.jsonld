  {
   "@type": "FAQPage",
   "@id": "https://get-lumic.com/st-louis/ai-consulting/#faq",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "Does lumic offer AI consulting in St. Louis?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. lumic is based in St. Louis, and its FDEs come on site across Greater St. Louis, Missouri and Illinois. The work starts with a free consultation, then an on-site day beside the people who do the back-office jobs by hand."
     }
    },
    {
     "@type": "Question",
     "name": "What does lumic automate?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Back-office jobs, one agent per job: vendor bills and PO matching, cash receipts and collections, the payroll journal entry, month-end close entries, and live dashboards and reporting."
     }
    },
    {
     "@type": "Question",
     "name": "How is lumic different from an AI consultant?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "A consultant advises and leaves. lumic’s FDEs build the agent inside your own systems and stay to run it after launch, for a monthly fee."
     }
    },
    {
     "@type": "Question",
     "name": "Who approves what the agent does?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "A person on your team. The agent makes the entry, and a person checks it and approves it before anything posts. The final post stays in your hands."
     }
    },
    {
     "@type": "Question",
     "name": "What does AI consulting and automation cost?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Free consultation. On-site work $1,500/day, credited toward phase one. Managed AI from $250 to $5,000 a month, depending on scope. Final pricing depends on your workflow and systems. These figures are starting points, not quotes."
     }
    },
    {
     "@type": "Question",
     "name": "Which areas does lumic serve?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Greater St. Louis: St. Louis City, St. Louis County, St. Charles County, Jefferson County and Franklin County in Missouri; Madison County and St. Clair County in Illinois. lumic travels for the right fit."
     }
    }
   ]
  },
