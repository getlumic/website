  {
   "@type": "WebPage",
   "@id": "https://get-lumic.com/faq/#webpage",
   "url": "https://get-lumic.com/faq/",
   "name": "FAQ: FDEs, AI agents and approvals | lumic",
   "description": "What an FDE is, where the agent runs, what it can touch, who approves its work, how long it takes to go live, and how lumic prices a job.",
   "inLanguage": "en",
   "about": {
    "@id": "https://get-lumic.com/#org"
   },
   "publisher": {
    "@id": "https://get-lumic.com/#org"
   },
   "breadcrumb": {
    "@id": "https://get-lumic.com/faq/#breadcrumb"
   }
  },
  {
   "@type": "BreadcrumbList",
   "@id": "https://get-lumic.com/faq/#breadcrumb",
   "itemListElement": [
    {
     "@type": "ListItem",
     "position": 1,
     "name": "Home",
     "item": "https://get-lumic.com/"
    },
    {
     "@type": "ListItem",
     "position": 2,
     "name": "FAQ",
     "item": "https://get-lumic.com/faq/"
    }
   ]
  },
  {
   "@type": "FAQPage",
   "@id": "https://get-lumic.com/faq/#faq",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "What is an FDE?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "FDE stands for Forward Deployed Engineer. lumic's FDEs are engineers with finance backgrounds who come to you, learn how the work is really done, build AI into one job at a time, and keep it working."
     }
    },
    {
     "@type": "Question",
     "name": "Where does the agent run?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Wherever fits your business, on its own dedicated computer, under its own login, inside the systems you already run, whether that's an ERP, accounting software, email, spreadsheets or cloud apps. To read a document, it uses a cloud AI model."
     }
    },
    {
     "@type": "Question",
     "name": "What can the agent touch?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Only what its job needs. lumic gives each agent access to the screens and records its job needs, and nothing more. Every action it takes is logged."
     }
    },
    {
     "@type": "Question",
     "name": "Who approves what the agent does?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "A person on your team. The agent makes the entry, and a person checks it and approves it before anything posts. The final post stays in your hands."
     }
    },
    {
     "@type": "Question",
     "name": "How long does it take to go live?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Weeks, not quarters. A recent managed AP agent went live about six weeks after the on-site day; in its first week, 64 of 67 bills went through the agent."
     }
    },
    {
     "@type": "Question",
     "name": "What does it cost?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "It depends on the job. After a 20-minute call, lumic sends a written proposal with what the team would build, the timeline, and the cost. Once an agent is live, lumic runs it for a monthly fee."
     }
    },
    {
     "@type": "Question",
     "name": "Do you work outside St. Louis?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. St. Louis first: the team is based here and comes on site in person. lumic travels for the right fit."
     }
    },
    {
     "@type": "Question",
     "name": "Does lumic sell software?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No. lumic does not sell software to configure yourself; the team stays to run what it builds."
     }
    },
    {
     "@type": "Question",
     "name": "What happens after an agent goes live?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "lumic runs it for a monthly fee. The team watches it, tests it every month, fixes what breaks, and upgrades it as AI improves. A person on your team approves anything before it posts."
     }
    },
    {
     "@type": "Question",
     "name": "What systems does lumic work with?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "If your team runs it, lumic can work with it, whether that's an ERP, accounting software, email, spreadsheets or cloud apps. The home page lists the systems."
     }
    },
    {
     "@type": "Question",
     "name": "Is lumic the right fit?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "lumic fits a business with people doing repetitive work by hand, that wants it done inside the systems the team already uses, with a person approving what matters. lumic may not be the right fit for buyers who want a self-serve software license to set up themselves, or an agent that acts with no person approving."
     }
    }
   ]
  },
  {
   "@type": "CollectionPage",
