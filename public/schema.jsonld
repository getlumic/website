   "url": "https://get-lumic.com/services/ap-automation/",
   "description": "The agent reads each vendor bill from email, matches it to the purchase order, and flags a price difference before anyone pays. A person approves it, and it lands in the client's accounting software, ready to post. lumic keeps it running for a monthly fee. An AP agent reads each vendor bill from email, matches it to the purchase order and enters it once a person approves. The bills it can't match go to a person with the reason. Live in weeks, not quarters."
  },
  {
   "@type": "VideoObject",
   "@id": "https://get-lumic.com/services/ap-automation/#overview-film",
   "name": "lumic overview: an AI agent enters a vendor bill",
   "description": "AI reads a vendor bill, matches it to its purchase orders and flags a price difference for approval. It drafts a purchase order, sends a statement, and answers a question with a drafted follow-up. Then live sales, cash and margin, all from one set of data. Every figure is sample data.",
   "thumbnailUrl": "https://get-lumic.com/video/demos/lumic-keynote-overview-poster.jpg",
   "contentUrl": "https://get-lumic.com/video/demos/lumic-keynote-overview.mp4",
   "uploadDate": "2026-10-10",
   "publisher": {
    "@id": "https://get-lumic.com/#org"
   }
  },
  {
   "@type": "FAQPage",
   "@id": "https://get-lumic.com/services/ap-automation/#faq",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "How long does it take to go live?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Weeks, not quarters. After the on-site day, lumic builds and tests the agent in your systems, then it goes live and lumic keeps it working."
     }
    },
    {
     "@type": "Question",
     "name": "Who approves what the agent does?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "A person on your team. The agent makes the entry, and a person checks it and approves it before anything posts. The final post stays in your hands."
     }
    },
    {
     "@type": "Question",
     "name": "Which systems does it work with?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "The accounting software or ERP, the email inbox and the system that holds the purchase orders: the ones your team already runs. Through an API where there is one, through the screen where there isn’t."
     }
    }
   ]
  },
