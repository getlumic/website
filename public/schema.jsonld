  {
   "@type": "FAQPage",
   "@id": "https://get-lumic.com/ai-implementation/#faq",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "What does AI implementation mean for a small business?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Putting AI to work inside the systems the business already runs, not buying a new tool to learn. lumic’s FDEs find the work done by hand, build an agent, an automation or a live dashboard for it, and keep it working. A person on your team approves what matters."
     }
    },
    {
     "@type": "Question",
     "name": "How long does an AI implementation take?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Weeks, not quarters. After the on-site day, lumic builds and tests the agent in your systems, then it goes live and lumic keeps it working."
     }
    },
    {
     "@type": "Question",
     "name": "What does it cost?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Free consultation. On-site work $1,500/day, credited toward phase one. Managed AI from $250 to $5,000 a month, depending on scope. Final pricing depends on your workflow and systems. These figures are starting points, not quotes."
     }
    }
   ]
  },
