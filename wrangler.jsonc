{
  "name": "website",
  "compatibility_date": "2025-01-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/video/*", "!/img/*", "!/*.png", "!/*.jpg", "!/*.svg", "!/*.ico"]
  },
  "workers_dev": true,
  "preview_urls": true
}
